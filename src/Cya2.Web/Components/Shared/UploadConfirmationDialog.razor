@inject DialogService DialogService
@inject IStringLocalizer<Resource> Localizer
@inject ILogger<UploadConfirmationDialog> Logger

@if (_preparing)
{
    <div role="status" aria-live="polite" aria-busy="true">
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <RadzenText>@Localizer["PreparingUploadPreview"]</RadzenText>
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </RadzenStack>
    </div>
}
else if (_preparationError is not null)
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <div role="alert">@_preparationError</div>
        <RadzenButton Text="@Localizer["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
    </RadzenStack>
}
else if (_confirmed)
{
    <UploadProgressDialog ProgressId="@ProgressId" SubmitImport="@SubmitImport" />
}
else
{
    var preview = _preparedPreview ?? Preview;
<RadzenCard Class="upload-confirm-dialog-card" Style="padding: 1rem; width:100%; max-width:100%; box-sizing:border-box;">
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Style="background-color:#f8f9fa; padding:0.75rem; border-radius:4px;">
            <div><b>@Localizer["FileName"]:</b> @preview?.FileName</div>
            <div><b>@Localizer["Size"]:</b> @(preview == null ? "" : FormatSize(preview.FileSizeBytes))</div>
            @if (preview != null && !IsLikelyExcelFile(preview))
            {
                <div style="color:#910813; font-weight:600;">
                    @Localizer["UploadInvalidExcelFormatMessage"]
                </div>
            }
        </RadzenStack>

        <RadzenText TextStyle="TextStyle.Body2">
            @Localizer["ConfirmFileUploadMessage"]
        </RadzenText>

        @if (preview?.MinimumDonationDate is { } boundary)
        {
            <div>
                <div><b>@Localizer["FirstDonation"]</b> @boundary.ToString("MMMM d, yyyy", CultureInfo.CurrentCulture)</div>
                <div><b>@Localizer["NumberOfRows"]</b> @(preview.SourceRowCount ?? 0)</div>
                <div><b>@Localizer["NumberOfDuplicateRowsRemoved"]</b> @preview.DuplicateRowsMerged</div>
                <div><b>@Localizer["TotalNumberOfDonations"]</b> @(preview.CanonicalDonationCount ?? 0)</div>
            </div>
            @if (preview.RequiresOldDateAcknowledgment)
            {
                <label>
                    <input type="checkbox" @bind="_oldDateAcknowledged" />
                    @Localizer["DonationOldDateConsent"]
                </label>
            }
        }

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem" Class="upload-confirm-actions">
            <RadzenButton Text="@Localizer["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
            <RadzenButton Text="@Localizer["Confirm"]"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@ConfirmUpload"
                          Disabled="@(preview == null || !IsLikelyExcelFile(preview) || (preview.RequiresOldDateAcknowledgment && !_oldDateAcknowledged))" />
        </RadzenStack>
    </RadzenStack>
</RadzenCard>
}

<style>
    .upload-confirm-dialog-card {
        min-width: 0 !important;
    }

    @@media (max-width: 768px) {
        .upload-confirm-actions {
            flex-direction: column !important;
            align-items: stretch !important;
        }

        .upload-confirm-actions .rz-button {
            width: 100%;
            justify-content: center;
            white-space: normal;
            text-align: center;
        }
    }
</style>

@code {
    [Parameter] public Cya2.Application.Interfaces.FilePreviewResult? Preview { get; set; }
    [Parameter] public Func<Task<Cya2.Application.Interfaces.FilePreviewResult>>? PreparePreview { get; set; }
    [Parameter] public string ProgressId { get; set; } = string.Empty;
    [Parameter] public Func<Task>? SubmitImport { get; set; }
    private Cya2.Application.Interfaces.FilePreviewResult? _preparedPreview;
    private string? _preparationError;
    private bool _preparing;
    private bool _oldDateAcknowledged;
    private bool _confirmed;

    protected override void OnInitialized()
    {
        _preparing = PreparePreview is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || PreparePreview is null) return;

        try
        {
            _preparedPreview = await PreparePreview();
        }
        catch (Exception exception)
        {
            Logger.LogError("Upload preview preparation failed. ExceptionType={ExceptionType}", exception.GetType().Name);
            _preparationError = cya2.Services.AdminNotificationPolicy.UploadErrorDetail(exception, Localizer);
        }
        finally
        {
            _preparing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ConfirmUpload()
    {
        if (SubmitImport is null) DialogService.Close(true);
        else _confirmed = true;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        double kb = bytes / 1024d;
        if (kb < 1024) return $"{kb:F1} KB";
        double mb = kb / 1024d;
        if (mb < 1024) return $"{mb:F1} MB";
        double gb = mb / 1024d;
        return $"{gb:F1} GB";
    }

    private static bool IsLikelyExcelFile(Cya2.Application.Interfaces.FilePreviewResult preview)
    {
        var ext = Path.GetExtension(preview.FileName ?? string.Empty);
        var hasXlsxExtension = string.Equals(ext, ".xlsx", StringComparison.OrdinalIgnoreCase);

        var ct = (preview.ContentType ?? string.Empty).Trim();
        var knownExcelType = string.Equals(ct, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", StringComparison.OrdinalIgnoreCase)
                             || string.Equals(ct, "application/vnd.ms-excel", StringComparison.OrdinalIgnoreCase)
                             || string.Equals(ct, "application/octet-stream", StringComparison.OrdinalIgnoreCase)
                             || string.IsNullOrWhiteSpace(ct);

        return hasXlsxExtension && knownExcelType;
    }
}
