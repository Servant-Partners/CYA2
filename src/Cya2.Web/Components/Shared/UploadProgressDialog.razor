@using Radzen
@implements IDisposable
@inject Cya2.Application.Interfaces.ISessionImportProgressService SessionImportProgressService
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject cya2.Services.Imports.ImportProgressService ProgressService
@inject Cya2.Application.Interfaces.IImportAuthorizationContext ImportAuthorizationContext
@inject IStringLocalizer<Resource> Localizer
@inject Cya2.Application.Interfaces.IImportOrchestrationService ImportOrchestrationService

@code {
    [Parameter] public string ProgressId { get; set; } = string.Empty;
    [Parameter] public Func<Task>? SubmitImport { get; set; }
    private bool _submissionFailed;
    private bool _cancelRequested;
    private int _polling;
    private readonly DateTime _openedAtUtc = DateTime.UtcNow;

    private System.Threading.Timer? _timer;

    private class ProgressDto
    {
        public int TotalRows { get; set; }
        public int InsertedRows { get; set; }
        public int FailedRows { get; set; }
        public int ExpectedRows { get; set; }
        public string? Status { get; set; }
        public bool IsComplete { get; set; }
        public List<string> Errors { get; set; } = new();
        public List<ImportStepDto> Steps { get; set; } = new();
        public string ImportType { get; set; } = string.Empty; // "Donations" or "Accounting"
    }
    
    private class ImportStepDto
    {
        public DateTime StartedAtUtc { get; set; }
        public DateTime? FinishedAtUtc { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public bool IsCompleted { get; set; }
        public bool IsActive { get; set; }
        public string Details { get; set; } = string.Empty;
    }

    private ProgressDto _p = new();
    private int Percent => _p.ExpectedRows > 0 ? (int)(100L * _p.TotalRows / _p.ExpectedRows) : 0;
    private bool _waitingForId => string.IsNullOrWhiteSpace(ProgressId);

    private async Task CancelImport()
    {
        try
        {
            if (await ImportOrchestrationService.CancelImportAsync(ProgressId)) _cancelRequested = true;
            else _p.Errors.Add(Localizer["ImportCancelUnavailable"]);
        }
        catch
        {
            _p.Errors.Add(Localizer["SafeOperationError"]);
        }
    }

    protected override void OnInitialized()
    {
        SessionImportProgressService.ImportProgressIdChanged += OnProgressIdChanged;
        // If session service already has an id (was set before dialog initialized), pick it up now
        if (string.IsNullOrWhiteSpace(ProgressId) && !string.IsNullOrWhiteSpace(SessionImportProgressService.ImportProgressId))
        {
            OnProgressIdChanged(SessionImportProgressService.ImportProgressId!);
        }
        _timer = new System.Threading.Timer(async _ => await Poll(), null, 250, 750);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || SubmitImport is null) return;
        try
        {
            await Task.Delay(50);
            await SubmitImport();
        }
        catch (Exception exception)
        {
            _submissionFailed = true;
            _p.IsComplete = true;
            _p.Status = Localizer["ImportSubmissionFailed"];
            _p.Errors.Add(cya2.Services.AdminNotificationPolicy.UploadErrorDetail(exception, Localizer));
            _timer?.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnProgressIdChanged(string id)
    {
        ProgressId = id;
        _p.Status = GetLocalizedString("Starting", "Starting...");
    }

    private async Task Poll()
    {
        if (_submissionFailed || System.Threading.Interlocked.Exchange(ref _polling, 1) != 0) return;
        try
        {
            if (string.IsNullOrWhiteSpace(ProgressId))
            {
                await InvokeAsync(() => { _p.Status = GetLocalizedString("WaitingForProgressId", "Waiting for ProgressId..."); StateHasChanged(); });
                return;
            }

            var actor = await ImportAuthorizationContext.GetCurrentActorAsync();
            var srv = actor is null ? null : ProgressService.GetOwned(ProgressId, actor.UserId);
            if (srv == null)
            {
                await InvokeAsync(() => { _p.Status = GetLocalizedString("InitializingImport", "Initializing import..."); StateHasChanged(); });
                return;
            }

            await InvokeAsync(() =>
            {
            if (_submissionFailed) return;
            _p.TotalRows = srv.TotalRows;
            _p.InsertedRows = srv.InsertedRows;
            _p.FailedRows = srv.FailedRows;
            _p.ExpectedRows = srv.ExpectedRows;
            _p.Status = string.IsNullOrWhiteSpace(srv.Status)
                ? GetLocalizedString("Processing", "Processing...")
                : srv.Status;
            _p.Errors = srv.Errors.ToList();
            _p.IsComplete = srv.IsComplete;
            _p.ImportType = srv.ImportType ?? string.Empty;

            // Map steps
            _p.Steps = srv.Steps.Select(s => new ImportStepDto
            {
                Name = s.Name,
                Status = s.Status,
                IsCompleted = s.IsCompleted,
                IsActive = s.IsActive,
                Details = s.Details
                , StartedAtUtc = s.StartedAtUtc, FinishedAtUtc = s.FinishedAtUtc
            }).ToList();

            // If import is complete, stop polling and update status
            if (_p.IsComplete)
            {
                _timer?.Dispose();
                _timer = null;
                
                // Set final status without repeating row count
                if (_p.Errors.Count > 0)
                {
                    _p.Status = srv.Status;
                }
                else if (_p.FailedRows > 0)
                {
                    _p.Status = string.Format(
                        GetLocalizedString("CompletedWithFailedRows", "{0} - {1} failed rows"),
                        GetLocalizedString("Completed", "Completed"),
                        _p.FailedRows);
                }
                else
                {
                    _p.Status = GetLocalizedString("Completed", "Completed");
                }
            }

            StateHasChanged();
            });
        }
        catch (Exception)
        {
            await InvokeAsync(() => { _p.Status = GetLocalizedString("SafeOperationError", "The operation could not be completed. Please try again."); StateHasChanged(); });
        }
        finally { System.Threading.Interlocked.Exchange(ref _polling, 0); }
    }

    public void Dispose()
    {
        if (!string.IsNullOrWhiteSpace(ProgressId) && _p.IsComplete)
        {
            ProgressService.Remove(ProgressId);
        }

        SessionImportProgressService.ImportProgressIdChanged -= OnProgressIdChanged;
        if (string.Equals(SessionImportProgressService.ImportProgressId, ProgressId, StringComparison.Ordinal))
        {
            SessionImportProgressService.SetImportProgressId(string.Empty);
        }
        _timer?.Dispose();
        _timer = null;
    }
}

<div class="upload-progress-dialog-root">
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.35rem" Class="upload-progress-content">
        <RadzenText TextStyle="TextStyle.Subtitle2">@GetDialogTitle()</RadzenText>
        <div role="status" aria-live="polite" style="min-height:28px;">
            @Localizer["ImportElapsed", (DateTime.UtcNow - _openedAtUtc).ToString(@"hh\:mm\:ss")]
            @if (!_p.IsComplete)
            {
                <div class="spinner-border spinner-border-sm upload-progress-spinner" aria-hidden="true"></div>
            }
        </div>
        
        @* Always reserve space for progress bar to prevent size changes *@
        <div>
            @if (_p.ExpectedRows > 0 && _p.Steps.Any(s => s.Name == "Data Import" && s.IsActive))
            {
                <RadzenProgressBar Value="@Percent" Max="100" ShowValue="true" />
                <div class="upload-progress-metrics" style="display: flex; justify-content: space-between; font-size: 0.9em; margin-top: 0.5rem;">
                    <span>@GetLocalizedString("Rows", "Rows"): @_p.TotalRows / @_p.ExpectedRows</span>
                    <span>@GetLocalizedString("Inserted", "Inserted"): @_p.InsertedRows</span>
                    <span>@GetLocalizedString("Failed", "Failed"): @_p.FailedRows</span>
                </div>
            }
            else
            {
                @* Invisible spacer to maintain consistent height *@
                <div></div>
            }
        </div>

        @* Step-by-step progress - Each step gets its own permanent box *@
        <RadzenCard Class="upload-progress-steps" Style="background-color: #f8f9fa; padding: 0.35rem;">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                @foreach (var step in SummarySteps())
                {
                    <div @key="step.Name" class="upload-progress-step @(step.IsCompleted ? "completed" : null)">
                        <div style="display:flex; align-items:center; gap:0.5rem;">
                            <i class="bi @(step.IsCompleted ? "bi-check-circle-fill upload-progress-step-check" : step.IsActive ? "bi-arrow-repeat" : "bi-circle")" aria-hidden="true"></i>
                            <strong>@GetLocalizedStepName(step.Name)</strong>
                        </div>
                        <span>@Localizer[step.IsCompleted ? "Completed" : step.IsActive ? (_p.IsComplete ? "ImportFailed" : "ImportWorking") : "NotStarted"]</span>
                    </div>
                }
            </RadzenStack>
        </RadzenCard>

        @* Overall status *@
        <div style="font-size: 0.9em; color: #495057; padding: 0.5rem; background-color: #e9ecef; border-radius: 0.25rem;">
            @GetLocalizedString("Status", "Status"): @Localizer[_p.IsComplete ? (_p.Errors.Count > 0 || _p.FailedRows > 0 ? "ImportFailed" : "Completed") : "ImportWorking"]
        </div>
        
        @* Errors section - Reserve space to prevent size changes *@
        <div class="upload-progress-errors">
            @if (_p.Errors.Count > 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Title="@GetLocalizedString("ImportWarnings", "Import Warnings")" Shade="Shade.Light">
                    <ul class="upload-progress-error-list">
                        @foreach (var e in _p.Errors.Take(2))
                        {
                            <li style="font-size: 0.85em;">@e</li>
                        }
                        @if (_p.Errors.Count > 2)
                        {
                             <li style="font-size: 0.85em;"><em>@string.Format(GetLocalizedString("MoreErrors", "... and {0} more errors"), _p.Errors.Count - 2)</em></li>
                        }
                    </ul>
                </RadzenAlert>
            }
        </div>
        
        @* Action buttons *@
        <div class="upload-progress-actions">
            @if (_p.IsComplete)
            {
                <RadzenButton Text="@GetLocalizedString("Done", "Done")" ButtonStyle="ButtonStyle.Success" Click="@(() => DialogService.Close(true))" />
            }
            else
            {
                <RadzenButton Text="@Localizer[_cancelRequested ? "ImportCancelRequested" : "Cancel"]" ButtonStyle="ButtonStyle.Danger"
                              Disabled="@(_cancelRequested || _waitingForId)" Click="@CancelImport" />
                <RadzenButton Text="@GetLocalizedString("Close", "Close")" ButtonStyle="ButtonStyle.Primary" Click="@(() => DialogService.Close(false))" />
            }
        </div>
    </RadzenStack>
</div>

<style>
    .upload-progress-dialog-root {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        height: min(560px, 88vh);
        max-height: 88vh;
        min-width: 0 !important;
        overflow: hidden;
        padding: 0.5rem;
        width: 100%;
    }

    .upload-progress-content {
        flex: 1;
        min-height: 0;
    }

    .upload-progress-spinner {
        margin-left: 0.4rem;
        margin-right: 0.25rem;
        vertical-align: -0.1em;
    }

    .upload-progress-steps {
        flex: 1;
        min-height: 0;
    }

    .upload-progress-step {
        align-items: center;
        background-color: #f8f9fa;
        border: 1px solid;
        border-radius: 0.375rem;
        box-sizing: border-box;
        display: flex;
        justify-content: space-between;
        min-height: 40px;
        padding: 0.3rem 0.45rem;
    }

    .upload-progress-step.completed {
        border-color: #0a3b6b !important;
    }

    .upload-progress-step-check {
        color: #0a3b6b;
    }

    .upload-progress-step span {
        color: #495057;
        font-size: 0.875rem;
        margin-left: 0.5rem;
        text-align: right;
    }

    .upload-progress-errors {
        flex: 0 0 auto;
        max-height: 82px;
        overflow: hidden;
    }

    .upload-progress-error-list {
        margin: 0;
        max-height: 2.8em;
        overflow: hidden;
        padding-left: 1rem;
    }

    .upload-progress-actions {
        display: flex;
        flex: 0 0 auto;
        gap: 0.75rem;
        justify-content: flex-end;
        padding-top: 0.25rem;
    }

    @@media (max-width: 768px) {
        .upload-progress-dialog-root {
            height: min(560px, 88vh);
            padding: 0.35rem;
        }

        .upload-progress-step {
            min-height: 36px;
            padding: 0.2rem 0.35rem;
        }

        .upload-progress-metrics {
            flex-wrap: wrap;
            gap: 0.25rem 0.75rem;
        }

    }
</style>

@code {
    private static readonly string[] SummaryNames = ["ImportSummaryPrepare", "ImportSummaryBackup", "ImportSummaryUpdate", "ImportSummaryFinish"];

    private static int SummaryIndex(string name) => name switch
    {
        "ImportSnapshot" or "Database Backup" or "Legacy Backup" => 1,
        "ImportDonorWrites" or "ImportDonationWrites" or "ImportContactEvidence" or "ImportContactProjection" or "ImportContactWrites"
            or "ImportFrequencyHistory" or "ImportFrequencyCalculation" or "ImportFrequencyWrites" or "Data Import" => 2,
        "ImportCommit" or "ImportCacheInvalidation" => 3,
        _ => 0
    };

    private IEnumerable<ImportStepDto> SummarySteps()
    {
        var current = _p.Steps.Count == 0 ? 0 : _p.Steps.Max(step => SummaryIndex(step.Name));
        var successful = _p.IsComplete && _p.Errors.Count == 0 && _p.FailedRows == 0;
        for (var index = 0; index < SummaryNames.Length; index++)
        {
            yield return new ImportStepDto
            {
                Name = SummaryNames[index],
                IsCompleted = successful || index < current,
                IsActive = !successful && index == current
            };
        }
    }

    private ImportStepDto? GetStep(string stepName)
    {
        return _p.Steps.FirstOrDefault(s => s.Name == stepName);
    }
    
    private string GetStepStatus(string stepName)
    {
        var step = GetStep(stepName);
        if (step == null) return GetLocalizedString("NotStarted", "Not started");
        return step.Status;
    }
    
    private string GetStepDetails(string stepName)
    {
        var step = GetStep(stepName);
        return step?.Details ?? string.Empty;
    }
    
    private string GetLocalizedStepName(string stepName)
    {
        if (stepName.StartsWith("Import", StringComparison.Ordinal)) return Localizer[stepName];
        return stepName switch
        {
            "File Validation" => GetLocalizedString("FileValidation", "File Validation"),
            "Legacy Backup" => GetLocalizedString("LegacyBackup", "Legacy Backup"),
            "Data Analysis" => GetLocalizedString("DataAnalysis", "Data Analysis"),
            "Database Backup" => GetLocalizedString("DatabaseBackup", "Database Backup"),
            "Data Import" => GetLocalizedString("DataImport", "Data Import"),
            _ => stepName
        };
    }
    
    private string GetLocalizedString(string key, string fallback)
    {
        try
        {
            var localized = Localizer[key];
            return localized.ResourceNotFound ? fallback : localized.Value;
        }
        catch
        {
            return fallback;
        }
    }
    
    private string GetDialogTitle()
    {
        return _p.ImportType switch
        {
            "Donations" => GetLocalizedString("UpdatingDonationDataTable", "Updating Donation Data Table"),
            "Accounting" => GetLocalizedString("UpdatingAccountingDataTable", "Updating Accounting Data Table"),
            _ => GetLocalizedString("DatabaseUpdateProgress", "Database Update Progress")
        };
    }
    
    private string GetStepBackgroundColor(string stepName)
    {
        var step = GetStep(stepName);
        if (step == null) return "#f8f9fa"; // Light gray (not started)
        if (step.IsCompleted) return "rgba(3, 166, 150, 0.1)"; // Very light teal from navbar gradient (completed)
        if (step.IsActive) return "rgba(5, 39, 103, 0.05)"; // Very light navy from navbar gradient (active)
        return "#f8f9fa"; // Light gray (not started)
    }
    
    private string GetStepBorderColor(string stepName)
    {
        var step = GetStep(stepName);
        if (step == null) return "#dee2e6"; // Light gray border
        if (step.IsCompleted) return "rgb(3, 166, 150)"; // Teal from navbar gradient (completed)
        if (step.IsActive) return "rgb(5, 39, 103)"; // Navy from navbar gradient (active)
        return "#dee2e6"; // Light gray border
    }
    
    private RenderFragment GetStepIcon(string stepName)
    {
        var step = GetStep(stepName);
        if (step == null)
        {
            return @<i class="bi bi-circle" style="color: #6c757d; font-size: 1.2em;"></i>;
        }
        
        if (step.IsCompleted)
        {
            return @<i class="bi bi-check-circle-fill" style="color: rgb(3, 166, 150); font-size: 1.2em;"></i>;
        }
        
        if (step.IsActive)
        {
            return @<div class="spinner-border spinner-border-sm" role="status" style="width: 1.2em; height: 1.2em; color: rgb(5, 39, 103);">
                        <span class="visually-hidden">Loading...</span>
                   </div>;
        }
        
        return @<i class="bi bi-circle" style="color: #6c757d; font-size: 1.2em;"></i>;
    }
}
